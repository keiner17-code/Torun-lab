# Conexión a la base de datos torun_monitor en Neon
DATABASE_URL=postgres://usuario:password@ep-xxxx.neon.tech/torun_monitor?sslmode=require

# Admin API key de Anthropic (organización completa). Empieza con sk-ant-admin...
# Solo se usa en los route handlers de /api/cron, nunca llega al cliente.
ANTHROPIC_ADMIN_KEY=sk-ant-admin-...

# Secreto para autenticar las llamadas a /api/cron/* (header: Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=

# PIN de acceso al panel /monitor (una sola sesión para toda la plataforma)
MONITOR_PIN=

# Secreto para firmar la cookie httpOnly de sesión (30 días)
SESSION_SECRET=

# Zona horaria usada para agrupar mensajes/costos por día (IANA tz db)
APP_TIMEZONE=America/Santo_Domingo
